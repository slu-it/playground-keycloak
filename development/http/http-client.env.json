{
  "dev": {
    "keycloak": {
      "host": "localhost",
      "port": 9000,
      "realm": "master"
    },
    "service": {
      "audience": "example-service"
    },
    "Security": {
      "Auth": {
        "keycloak-admin": {
          "Type": "OAuth2",
          "Grant Type": "Password",
          "Username": "{{adminUsername}}",
          "Password": "{{adminPassword}}",
          "Client ID": "admin-cli",
          "Token URL": "http://localhost:9000/realms/master/protocol/openid-connect/token"
        }
      }
    }
  }
}
